#!/usr/bin/env bash
# 本仓 pre-commit（2026-11-07 起退役为「纯自有链」）：白名单/索引/自动区块检查。
#
# Einfacht 段已迁出 —— core.hooksPath 已撤销，钩子由 .git/hooks 的链式 wrapper
# 接管（install.py --chain 生成：先跑本文件（以 einfacht-prev 副本形式），后跑
# reflect-hooks/gate.py commit）。本文件保留为 --uninstall 后的手动回滚入口，
# 不再被默认钩子链调用。
#
# ⚠️ $PWD 可能是**别人的仓库**（钩子被继承）：没有 .githooks/update-readme.py
#    就跳过，钩子本体通用。
set -euo pipefail
REPO="$(git rev-parse --show-toplevel)"
cd "$REPO"

[ -f "$REPO/.githooks/update-readme.py" ] || exit 0

# ── ③ 本仓既有检查：白名单 / 索引同步 / handoff 时效 / 两处自动区块 ─────────
python3 "$REPO/.githooks/update-readme.py"

# Einfacht.env —— 本仓事实系统配置（由 reflect-hooks/einfacht-env.sh 自动加载）
#
# 为什么有这个文件：git 不把自定义环境变量传给钩子，只在 shell 里 export 的
# REFLECT_* 钩子看不见；文件才是钩子可复现的来源。没有本文件 ⇒ 全部旋钮回落默认名。
#
# ⚠️ 本文件受 check_envfile.py 守：旋钮名 typo / file·list·dir 旋钮指向不存在的
#    路径 / 空值 / sh 语法坏 都会报。值都是「相对仓库根的名字」。

export REFLECT_FACTS="FACTS.json"
export REFLECT_DOC="STATE.md"
export REFLECT_DOCS="STATE.md,AGENTS.md"

export REFLECT_QUESTIONS="questions"
export REFLECT_RETRACTIONS="retractions.json"
export REFLECT_INVARIANTS="invariants.json"

# 本仓只有单语 README（中文）⇒ 三语判据按名单收窄为一份：
# 存在 / 非空判据照常，互链判据自动退化（闸门会明说「不适用」）。
export REFLECT_READMES="README.md"

# ── 本仓的两个本地化配置（2026-10-31 接入整改版 Einfacht 时从手工 hack 转正式旋钮）──
#
# 这两条以前是**改 zreflect/ 源码**实现的（手工 hack），代价是每次升级上游都要
# 手动合并。整改版 Einfacht 把它们做成了正式旋钮（上游 README 里直接点名本仓）：
#
# ① REFLECT_MEASURE_MODULE：采集模块名。本仓要量的是课程/站点事实，不是上游那个
#    数 py/md 的占位实现。以前 facts.py 里写死了「GATE_REPO 是不是本仓」的路径比较，
#    现在改成一行配置。空着会响亮警告（空台账绝不静默）。
export REFLECT_MEASURE_MODULE="measure_edu"

# ② REFLECT_PHASES：追加自定义相位。本仓的 `lab` 相位（实验目录在场才跑）以前被迫
#    fork registry.py 的 PHASES 元组；现在内置两个不可删，自定义追加进来即可。
export REFLECT_PHASES="lab"

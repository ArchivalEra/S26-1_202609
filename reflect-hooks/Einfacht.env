# Einfacht.env —— 本仓事实系统配置（新版 Einfacht @ b815cd1）
#
# 为什么有这个文件：git 不把自定义环境变量传给钩子，只在 shell 里 export 的
# REFLECT_* 钩子看不见；文件才是钩子可复现的来源。没有本文件 ⇒ 全部旋钮回落默认名。
#
# ⚠️ 本文件受 check_envfile.py 守：旋钮名 typo / file·list·dir 旋钮指向不存在的
#    路径 / 空值 / sh 语法坏 都会报。值都是「相对仓库根的名字」。
#
# 2026-11-07 新版迁移要点：
#   · REFLECT_HANDOFF 删除（新版名册没有；check_handoff 改用私有变量 HANDOFF_SPEC）；
#   · REFLECT_IDENTITY / REFLECT_SEMANTICS 同理（私有变量 IDENTITY_SPEC / SEMANTICS_SPEC）；
#   · 新增 REFLECT_LANG=zh（零语言制度的本仓语言）；en/de 包是套件自带的三语
#     自证对象（check_i18n 的两条自证要用），不是本仓的界面语言。

export REFLECT_FACTS="FACTS.json"
export REFLECT_DOC="STATE.md"
export REFLECT_DOCS="STATE.md,AGENTS.md"

export REFLECT_QUESTIONS="questions"
export REFLECT_RETRACTIONS="retractions.json"
export REFLECT_INVARIANTS="invariants.json"

# 本仓只有单语 README（中文）⇒ 三语判据按名单收窄为一份：
# 存在 / 非空判据照常，互链判据自动退化（闸门会明说「不适用」）。
export REFLECT_READMES="README.md"

# 语言：本仓读者是 zh 单人（站长）。en/de 包只为 check_i18n 的自证存在。
export REFLECT_LANG="zh"

# 本仓自定义相位：lab（实验目录在场才跑，check_lab_integrity）。
export REFLECT_PHASES="lab"

# 采集模块：本仓要量的是课程/站点事实，不是数 py/md 的占位实现。
export REFLECT_MEASURE_MODULE="measure_edu"

# ① 陈旧断言检测（check_stale，泛化自旧 check_handoff 的 L1/L3）：
#    活状态里出现这些**退役名**=「还在用」的断言 ⇒ 报。
#    （「150 张」是 R-101 翻案的旧图库总数；新名单随翻案追加。）
export REFLECT_RETIRED="150 张"

# ② 测龄报警阈值：台账事实 measured_at 超过这个天数 ⇒ check_stale 报。
#    课程资料变化频繁，14 天是「该重测了」的软信号。
export REFLECT_STALE_DAYS="14"


# ══ 2026-11-07 迁移期放宽（照 Octave-Extra-Content 同款做法）══════════════
# ④ 上游 check_facts 新增「反向判据」（issue #24，白名单式）：活状态里 ≥ 阈值的
#    数字都必须在台账 / [[键名]] / 形状白名单里有出处。本仓 STATE.md 与 AGENTS.md
#    有大量历史手抄实测数字（含 A 批 gitroll 整改记录里的计数），迁移期先放宽；
#    迁移完成即删此行（照隔壁仓 questions/06 的账单格式补悬案）。
#    ⚠️ 作用域（隔壁仓实测纠正）：_bare_min 是两条判据共用的阈值 —— 放宽会同时
#    短路「无出处数字」与「抄了台账值没写 [[键名]]」；块一致性 / 坏引用照跑。
export REFLECT_NAKED_MIN=99999999

# ⑤ 上游 doc.py 把 PRINCIPLES.md 纳入活状态面；本仓本轮不引入 AUTO:RULES 表
#    （原则先留在 AGENTS.md 散文里），显式声明不用。
export REFLECT_NO_PRINCIPLES=1
